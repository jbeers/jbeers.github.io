<section class="page-section" aria-labelledby="powershell-title">
  <h2 id="powershell-title">PowerShell</h2>
  {% highlight "powershell" %}Invoke-RestMethod "https://jbeers.github.io/res/my_terminal_config.ps1" | Invoke-Expression{% endhighlight %}
  <button type="button" onclick="navigator.clipboard.writeText('Invoke-RestMethod &quot;https://jbeers.github.io/res/my_terminal_config.ps1&quot; | Invoke-Expression')" aria-label="Copy PowerShell command">Copy command</button>
  <a class="resource-link" href="{{ '/res/my_terminal_config.ps1' | url }}">Review the PowerShell source</a>
</section>
<section class="page-section" aria-labelledby="bash-title">
  <h2 id="bash-title">Bash</h2>
  {% highlight "bash" %}source <(curl -sSL "https://github.com/jbeers/jtb-env/blob/main/shell-scripts/.bashrc?raw=true"){% endhighlight %}
  <button type="button" onclick="navigator.clipboard.writeText('source &lt;(curl -sSL &quot;https://github.com/jbeers/jtb-env/blob/main/shell-scripts/.bashrc?raw=true&quot;)')" aria-label="Copy Bash command">Copy command</button>
  <a class="resource-link" href="https://github.com/jbeers/jtb-env/blob/main/shell-scripts/.bashrc">Review the Bash source</a>
</section>
