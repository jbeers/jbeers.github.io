---
title: Articles
layout: base
description: "Notes by Jacob Beers on software, systems, productivity, and things worth understanding."
---
<header class="page-intro">
  <p class="eyebrow">Articles &amp; notes</p>
  <h1>Writing.</h1>
  <p class="lede">Notes on software, systems, and things worth understanding.</p>
</header>

{% for post in collections.article %}
{% if post.data.featured %}
<article class="article-feature">
  <div>
    <p class="eyebrow">Featured article</p>
    <h2><a href="{{ post.url | url }}">{{ post.data.title }}</a></h2>
    <p>{{ post.data.description }}</p>
    <a class="text-link" href="{{ post.url | url }}">Read article <span aria-hidden="true">→</span></a>
  </div>
  <a class="feature-image" href="{{ post.url | url }}" tabindex="-1" aria-hidden="true">
    <img src="{{ post.data.cover | url }}" alt="" width="800" height="840">
  </a>
</article>
{% endif %}
{% endfor %}

<section class="page-section" aria-labelledby="all-writing-title">
  <p class="eyebrow">The archive</p>
  <h2 id="all-writing-title">More to explore.</h2>
  <ul class="article-list">
    {% for post in collections.article | reverse %}
    {% if not post.data.featured %}
    <li{% if post.data.cover %} class="illustrated-post"{% endif %}>
      {% if post.data.cover %}<img src="{{ post.data.cover | url }}" alt="" width="360" height="240" loading="lazy">{% endif %}
      <div>
        <p class="eyebrow"><time datetime="{{ post.date | date('yyyy-MM-dd') }}">{{ post.date | date("yyyy-MM-dd") }}</time></p>
        <h3><a href="{{ post.url | url }}">{{ post.data.title }} <span aria-hidden="true">→</span></a></h3>
        {% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
      </div>
    </li>
    {% endif %}
    {% endfor %}
  </ul>
</section>
