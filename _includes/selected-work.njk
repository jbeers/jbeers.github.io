<div class="work-list">
  {% for project in work %}
  <article class="work-item{% if loop.first %} work-featured{% endif %}">
    <a class="work-art-link" href="{{ project.image | url }}" aria-label="Open full-size illustration: {{ project.title }}">
      <img class="editorial-art work-art" src="{{ project.image | url }}" alt="{{ project.imageAlt }}" width="{{ project.imageWidth }}" height="{{ project.imageHeight }}" loading="lazy" decoding="async">
    </a>
    <div class="work-copy">
      <p class="eyebrow">{{ project.category }}</p>
      <h3>{{ project.title }}</h3>
      <p>{{ project.description }}</p>
    </div>
  </article>
  {% endfor %}
</div>
